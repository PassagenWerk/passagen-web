# Copy this file to .env and fill in local values. Never commit .env.

# Published image to run. Pin a release tag for reproducible deployments.
PASSAGEN_IMAGE=docker.io/sycstudio/passagen:0.9.0

# GROBID image used for PDF header and full-text parsing.
GROBID_IMAGE=docker.io/lfoppiano/grobid:0.9.1-crf

# Required by the default passagen.yaml for LLM-backed processing and research.
PASSAGEN_API_KEY=

# Bind address on the Docker host. Keep localhost for local-only use; use 0.0.0.0 for LAN access.
PASSAGEN_BIND=127.0.0.1

# Complete origin shown in the browser address bar.
PASSAGEN_ALLOWED_ORIGIN=http://127.0.0.1:8765

# Named volume for a new library, or the host path of an existing library.
PASSAGEN_DATA_DIR=passagen-data

# Host user/group that owns PASSAGEN_DATA_DIR.
PUID=1000
PGID=1000
